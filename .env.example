# Frontend (public). Without these the app runs on demo data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Edge function secrets — never prefix with VITE_, set them with:
#   supabase secrets set --env-file supabase/functions/.env
# CRON_SECRET=<random string>
# MOBILE_DE_USERNAME=
# MOBILE_DE_PASSWORD=
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
